# ════════════════════════════════════════════════════════════
#  BailaNow — Variables de entorno
#  Copia este fichero como .env.local (nunca lo comites con valores reales)
# ════════════════════════════════════════════════════════════

# ─── SUPABASE ────────────────────────────────────────────────
# Panel: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── STRIPE ──────────────────────────────────────────────────
# Panel: https://dashboard.stripe.com/apikeys
# IMPORTANTE: VITE_STRIPE_PUBLISHABLE_KEY va al cliente (pk_*)
#             STRIPE_SECRET_KEY es SOLO para Edge Functions (sk_*)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Webhook secret (Stripe Dashboard → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── PAYPAL ──────────────────────────────────────────────────
# Panel: https://developer.paypal.com/dashboard/applications
# IMPORTANTE: VITE_PAYPAL_CLIENT_ID va al cliente
#             PAYPAL_CLIENT_SECRET es SOLO para Edge Functions
VITE_PAYPAL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# 'sandbox' para pruebas, 'production' para producción
PAYPAL_ENV=sandbox

# ─── GOOGLE OAUTH ────────────────────────────────────────────
# Configura en: Supabase Dashboard → Auth → Providers → Google
# Y en: console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Los Client ID y Secret se pegan en el panel de Supabase, NO aquí.
# Solo necesitas asegurarte de añadir la URL de callback en Google Console:
#   https://TU-PROYECTO.supabase.co/auth/v1/callback
# Y en Supabase Auth → URL Configuration → Redirect URLs:
#   https://bailanow.com/auth/callback
#   http://localhost:3000/auth/callback  (para dev)

# ─── PLATAFORMA ──────────────────────────────────────────────
# URL pública de la app (usada en PayPal return/cancel URLs y CORS)
APP_URL=https://bailanow.com
VITE_APP_URL=https://bailanow.com
VITE_APP_NAME=BailaNow

# Tasa de comisión de la plataforma (0.15 = 15%)
VITE_PLATFORM_COMMISSION=0.15

# ─── SENTRY (opcional, captura de errores en producción) ─────
# Crear cuenta en https://sentry.io → New Project → React
# Pega la DSN que te dan (es una URL pública, no es secreta)
VITE_SENTRY_DSN=
