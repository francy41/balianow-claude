# Cabeceras de caché para los assets estáticos servidos por Cloudflare Workers.
#
# Problema que resuelve: al desplegar, Vite genera ficheros con hash en el nombre
# (app-A1b2C3.js). Si el navegador conserva en caché el index.html anterior, sigue
# pidiendo los ficheros del despliegue viejo y la web "se ve igual" aunque el
# deploy haya ido bien.
#
# Solución: el HTML nunca se cachea (siempre se revalida contra el servidor) y los
# assets con hash se cachean para siempre — su nombre cambia en cada build, así que
# no hay riesgo de servir uno obsoleto.

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
